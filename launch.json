{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Rimworld Mod Project",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build ${input:rimWorldVersion}",
            "args": [
                "--host",
                "bash",
                "-c",
                // Share the running Steam client's PID namespace so steamclient.so can find and talk to it
                "steam_pid=$(pgrep -o -f '/ubuntu12_32/steam ') || { echo 'Steam is not running' >&2; exit 1; }; exec flatpak run --parent-pid=\"$steam_pid\" --parent-share-pids \"$@\"",
                "bash",
                "--filesystem=${workspaceFolder}",
                "--filesystem=/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}",
                "--env=HARMONY_LOG_FILE=${workspaceFolder}/.savedatafolder/${input:rimWorldVersion}/Harmony.log",
                "--env=PRESSURE_VESSEL_FILESYSTEMS_RW=${workspaceFolder}:/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}",
                "--env=SteamAppId=294100",
                "--env=SteamGameId=294100",
                "--command=/home/alex/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SteamLinuxRuntime_soldier/_v2-entry-point",
                "com.valvesoftware.Steam",
                "--verb=waitforexitandrun",
                "--",
                "/home/alex/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SteamLinuxRuntime/scout-on-soldier-entry-point-v2",
                "--",
                "/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}/RimWorld/RimWorldLinux",
                "-popupwindow",
                "-savedatafolder=${workspaceFolder}/.savedatafolder/${input:rimWorldVersion}",
                "-logfile",
                "${workspaceFolder}/.savedatafolder/${input:rimWorldVersion}/Player.log"
            ],
            "program": "flatpak-spawn",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Rimworld",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build ${input:rimWorldVersion}",
            "args": [
                "--host",
                "bash",
                "-c",
                // Share the running Steam client's PID namespace so steamclient.so can find and talk to it
                "steam_pid=$(pgrep -o -f '/ubuntu12_32/steam ') || { echo 'Steam is not running' >&2; exit 1; }; exec flatpak run --parent-pid=\"$steam_pid\" --parent-share-pids \"$@\"",
                "bash",
                "--filesystem=${workspaceFolder}",
                "--filesystem=/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}",
                "--env=HARMONY_LOG_FILE=${workspaceFolder}/.savedatafolder/${input:rimWorldVersion}/Harmony.log",
                "--env=PRESSURE_VESSEL_FILESYSTEMS_RW=${workspaceFolder}:/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}",
                "--env=SteamAppId=294100",
                "--env=SteamGameId=294100",
                "--command=/home/alex/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SteamLinuxRuntime_soldier/_v2-entry-point",
                "com.valvesoftware.Steam",
                "--verb=waitforexitandrun",
                "--",
                "/home/alex/.var/app/com.valvesoftware.Steam/.local/share/Steam/steamapps/common/SteamLinuxRuntime/scout-on-soldier-entry-point-v2",
                "--",
                "/home/alex/Documents/Projects/RimWorld/rimworld-utils/Games/${input:rimWorldVersion}/RimWorld/RimWorldLinux",
                "-logfile",
                "${workspaceFolder}/.savedatafolder/${input:rimWorldVersion}/Player.log"
            ],
            "program": "flatpak-spawn",
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        }
    ],
    "inputs": [
        {
            "id": "rimWorldVersion",
            "type": "pickString",
            "description": "Rimworld version to launch?",
            "options": [
                "1.6",
                "1.5",
                "1.4",
                "1.3"
            ],
            "default": "1.6"
        }
    ]
}
