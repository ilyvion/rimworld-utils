{
    "version": "2.0.0",
    "tasks": [
        // TODO: Not yet implemented
        // {
        //     "label": "build all versions",
        //     "type": "shell",
        //     "group": {
        //         "kind": "build",
        //         "isDefault": false
        //     },
        //     "command": ".vscode/buildAll.sh",
        //     "problemMatcher": []
        // },
        {
            "label": "build choose version",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": ".vscode/build.sh",
            "args": [
                "${input:rimWorldVersion}"
            ],
            "problemMatcher": []
        },
        {
            "label": "build 1.6",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": ".vscode/build.sh",
            "args": [
                "1.6"
            ],
            "problemMatcher": []
        },
        {
            "label": "build 1.7",
            "type": "shell",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": ".vscode/build.sh",
            "args": [
                "1.7"
            ],
            "problemMatcher": []
        },
        {
            // Runs until the game exits; counts as started once the game waits for a debugger
            "label": "start 1.7 for debugging",
            "type": "shell",
            "command": "${workspaceFolder}/../rimworld-utils/debug-launch.sh",
            "args": [
                "1.7"
            ],
            "dependsOn": "build 1.7",
            "isBackground": true,
            "problemMatcher": {
                "owner": "rimworld-debug-launch",
                // A problem matcher requires a pattern; this one never matches, so no problems are reported
                "pattern": {
                    "regexp": "^__no_problems__$"
                },
                "background": {
                    "beginsPattern": "^Starting RimWorld",
                    "endsPattern": "^RimWorld is waiting for a debugger"
                }
            }
        }
    ],
    "inputs": [
        {
            "id": "rimWorldVersion",
            "type": "pickString",
            "description": "Rimworld version to build?",
            "options": [
                "1.7",
                "1.6",
                "1.5",
                "1.4",
                "1.3"
            ],
            "default": "1.7"
        }
    ]
}
