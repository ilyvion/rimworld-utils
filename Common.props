<Project>
    <!-- Feature toggles / pins (override per project/CI if needed) -->
    <PropertyGroup>
        <!-- TODO: When nearly all projects use it, switch this to true -->
        <UseLaboratory Condition="'$(UseLaboratory)'==''">false</UseLaboratory>
        <UseTaggedUnions Condition="'$(UseTaggedUnions)'==''">false</UseTaggedUnions>
        <RimWorldVersion Condition="'$(RimWorldVersion)'==''">1.7</RimWorldVersion>
    </PropertyGroup>
    <PropertyGroup>
        <OutputType>Library</OutputType>
        <PlatformTarget>x64</PlatformTarget>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <EnableNETAnalyzers>True</EnableNETAnalyzers>
        <AnalysisLevel>preview-all</AnalysisLevel>
        <ErrorReport>prompt</ErrorReport>
        <WarningLevel>9999</WarningLevel>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <Choose>
        <When Condition="'$(RimWorldVersion)' == '1.7'">
            <PropertyGroup>
                <TargetFramework>net10.0</TargetFramework>
            </PropertyGroup>
        </When>
        <Otherwise>
            <PropertyGroup>
                <TargetFramework>net481</TargetFramework>
            </PropertyGroup>
        </Otherwise>
    </Choose>
    <PropertyGroup>
        <ProjectDependenciesBasePath Condition="'$(ProjectDependenciesBasePath)'==''"
            >..\..\..</ProjectDependenciesBasePath>
        <RimWorldSteamWorkshopFolderPath Condition="'$(RimWorldSteamWorkshopFolderPath)'==''"
            >..\..\.deps\refs</RimWorldSteamWorkshopFolderPath>
        <DefaultItemExcludes>$(DefaultItemExcludes);obj/**</DefaultItemExcludes>
        <BaseIntermediateOutputPath>obj/$(RimWorldVersion)</BaseIntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup>
        <OutputPath>../../$(RimWorldVersion)/Assemblies</OutputPath>
        <DebugType>portable</DebugType>
        <DebugSymbols>true</DebugSymbols>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
    </PropertyGroup>
    <Choose>
        <When Condition="'$(RimWorldVersion)' == '1.7'">
            <PropertyGroup>
                <DefineConstants>$(DefineConstants);v1_7;v1_7_OR_GREATER;v1_6_OR_GREATER;v1_5_OR_GREATER;v1_4_OR_GREATER;v1_3_OR_GREATER</DefineConstants>
                <!-- .NET (Core) class libraries don't copy NuGet dependencies to the output by default, but we want that -->
                <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
            </PropertyGroup>
        </When>
        <When Condition="'$(RimWorldVersion)' == '1.6'">
            <PropertyGroup>
                <DefineConstants>$(DefineConstants);v1_6;v1_6_OR_GREATER;v1_5_OR_GREATER;v1_4_OR_GREATER;v1_3_OR_GREATER</DefineConstants>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony" Version="2.4.2">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
            </ItemGroup>
        </When>
        <When Condition="'$(RimWorldVersion)' == '1.5'">
            <PropertyGroup>
                <DefineConstants>$(DefineConstants);v1_5;v1_5_OR_GREATER;v1_4_OR_GREATER;v1_3_OR_GREATER</DefineConstants>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony" Version="[2.3.3]">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
            </ItemGroup>
        </When>
        <When Condition="'$(RimWorldVersion)' == '1.4'">
            <PropertyGroup>
                <DefineConstants>$(DefineConstants);v1_4;v1_4_OR_GREATER;v1_3_OR_GREATER</DefineConstants>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony" Version="[2.2.2]">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
            </ItemGroup>
        </When>
        <When Condition="'$(RimWorldVersion)' == '1.3'">
            <PropertyGroup>
                <DefineConstants>$(DefineConstants);v1_3;v1_3_OR_GREATER</DefineConstants>
            </PropertyGroup>
            <ItemGroup>
                <PackageReference Include="Lib.Harmony" Version="[2.2.2]">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
            </ItemGroup>
        </When>
    </Choose>
    <Choose>
        <When Condition="'$(RimWorldVersion)' == '1.7'">
            <ItemGroup>
                <!-- Newest 3.0.x, prereleases included -->
                <PackageReference Include="Lib.Harmony" Version="3.0.*-*">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
                <!-- Newest 1.7.x, prereleases included -->
                <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.*-*">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
            </ItemGroup>
        </When>
        <Otherwise>
            <ItemGroup>
                <PackageReference Include="Krafs.Rimworld.Ref" Version="$(RimWorldVersion).*">
                    <ExcludeAssets>runtime</ExcludeAssets>
                </PackageReference>
                <PackageReference Include="PolySharp" Version="1.14.1">
                    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
                    <PrivateAssets>all</PrivateAssets>
                </PackageReference>
            </ItemGroup>
        </Otherwise>
    </Choose>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.2.1">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>
    <ItemGroup Condition="'$(UseLaboratory)'=='true'">
        <ProjectReference Include="$(ProjectDependenciesBasePath)\ilyvion.Laboratory\Source\ilyvion.Laboratory\ilyvion.Laboratory.csproj">
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>
    <ItemGroup Condition="'$(UseTaggedUnions)'=='true'">
        <ProjectReference
            Include="$(MSBuildThisFileDirectory)TaggedUnions\TaggedUnions.csproj"
            OutputItemType="Analyzer"
            ReferenceOutputAssembly="false"
        />
    </ItemGroup>
    <ItemGroup>
        <Compile Update="**/*.cs">
            <Features>strict</Features>
        </Compile>
        <Compile Include="$(MSBuildThisFileDirectory)globalusings.cs" Link="globalusings.cs" />
        <Compile
            Include="$(MSBuildThisFileDirectory)GlobalSuppressions.cs"
            Link="GlobalSuppressions.cs"
        />
    </ItemGroup>
</Project>
