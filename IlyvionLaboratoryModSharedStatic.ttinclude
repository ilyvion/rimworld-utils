<#
    void IlyvionLaboratoryModSharedStatic(
        string modBaseNamespace,
        string modClassName,
        string classVisibility = "internal",
        string settingsClassName = null)
    {
#>
namespace <#=modBaseNamespace#>;

<#=classVisibility#> partial class <#=modClassName#> : IlyvionMod
{
#pragma warning disable CS8618 // Set by constructor
    /// <summary>
    /// Gets the singleton instance of the <see cref="<#=modClassName#>"/> class.
    /// </summary>
    public static <#=modClassName#> Instance { get; private set; }

#pragma warning restore CS8618

    /// <summary>
    /// Gets the package ID of the mod.
    /// </summary>
    public static string PackageId => Instance.Content.PackageId;

    /// <summary>
    /// Initializes a new instance of the <see cref="<#=modClassName#>"/> class.
    /// </summary>
    /// <param name="content">The mod content pack.</param>
    public <#=modClassName#>(ModContentPack content)
        : base(content)
    {
        Instance = this;
        Construct();
    }

    [System.Diagnostics.CodeAnalysis.SuppressMessage(
        "Performance",
        "CA1822:Mark members as static",
        Justification = "Implementations may or may not use instance data"
    )]
    partial void Construct();
<#
        if (!string.IsNullOrEmpty(settingsClassName)) {
#>

    /// <inheritdoc/>
    public override void DoSettingsWindowContents(Rect inRect) =>
        Settings.DoSettingsWindowContents(inRect);

    /// <inheritdoc/>
    protected override bool HasSettings => true;

    /// <summary>
    /// Gets the settings for the mod.
    /// </summary>
    public static <#=settingsClassName#> Settings => Instance.GetSettings<<#=settingsClassName#>>();
<#
        }
#>
